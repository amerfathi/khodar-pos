{
  "name": "khodar-pos",
  "private": true,
  "version": "2.5.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.khodarpos.app",
    "productName": "KhodarPOS",
    "directories": {
      "output": "C:/Users/IMDAD/AppData/Local/Temp/khodar-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "سوق الخضار - كاشير ومحاسبة",
      "artifactName": "KhodarPOS-Setup.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.1",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
